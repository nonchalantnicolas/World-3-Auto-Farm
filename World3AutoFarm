local table_insert = table.insert

local nicolas = {}
nicolas.__index = nicolas

function nicolas.new()
    return setmetatable({_tasks = {}, _destroyed = false}, nicolas)
end

function nicolas:GiveTask(task)
    if self._destroyed then
        self:_cleanupTask(task)
        return
    end
    table_insert(self._tasks, task)
    return task
end

function nicolas:GiveTasks(...)
    for _, task in ipairs({...}) do
        self:GiveTask(task)
    end
end

function nicolas:_cleanupTask(task)
    local taskType = typeof(task)
    if taskType == "RBXScriptConnection" then
        task:Disconnect()
    elseif taskType == "Instance" then
        task:Destroy()
    elseif taskType == "function" then
        task()
    elseif taskType == "table" and type(task.Destroy) == "function" then
        task:Destroy()
    end
end

function nicolas:DoCleaning()
    if self._destroyed then return end
    self._destroyed = true
    for _, task in ipairs(self._tasks) do
        self:_cleanupTask(task)
    end
    self._tasks = {}
end

function nicolas:Destroy()
    self:DoCleaning()
end

local RootNicolas = nicolas.new()
local shared = odh_shared_plugins

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

local features = {
    autoFarm = false,
    targetStage = "Stage 1",
}

local waypoints = {
    ["Stage 1"] = {
        Vector3.new(-1456,-161,-864),
        Vector3.new(-1480,-161,-864),
        Vector3.new(-1482,-140,-777),
        Vector3.new(-1480,-108,-675),
        Vector3.new(-1480,-77,-576),
        Vector3.new(-1482,-70,-532),
        Vector3.new(-1456,-70,-519),
        Vector3.new(-1483,-68,-517),
    },
}

local DEFAULT_SPEED = 160
local rotationSpeed = 100

local character, hrp, humanoid
local moving = false
local currentTarget = nil
local currentSpeed = DEFAULT_SPEED
local died = false
local needsFreshCharacter = false

local facingConn
local att
local angVel
local autoRotateThread

local function stopFacing()
    if facingConn then
        facingConn:Disconnect()
        facingConn = nil
    end
    if att then
        att:Destroy()
        att = nil
    end
    if angVel then
        angVel:Destroy()
        angVel = nil
    end
    if autoRotateThread then
        autoRotateThread:Disconnect()
        autoRotateThread = nil
    end
    if humanoid then
        humanoid.AutoRotate = true
    end
end

local function startFacing()
    if not hrp then return end

    stopFacing()

    autoRotateThread = RunService.Heartbeat:Connect(function()
        if humanoid and humanoid.Parent then
            humanoid.AutoRotate = false
        end
    end)

    att = Instance.new("Attachment")
    att.Parent = hrp

    angVel = Instance.new("AngularVelocity")
    angVel.Attachment0 = att
    angVel.RelativeTo = Enum.ActuatorRelativeTo.World
    angVel.MaxTorque = math.huge
    angVel.AngularVelocity = Vector3.zero
    angVel.Parent = hrp

    facingConn = RunService.RenderStepped:Connect(function()
        if not hrp or not hrp.Parent then return end

        local _, y, _ = hrp.CFrame:ToOrientation()
        hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, y, 0)

        if not currentTarget then
            angVel.AngularVelocity = Vector3.zero
            return
        end

        local myPos = hrp.Position
        local targetPos = currentTarget

        local dir = Vector3.new(
            targetPos.X - myPos.X,
            0,
            targetPos.Z - myPos.Z
        )

        if dir.Magnitude < 0.001 then
            angVel.AngularVelocity = Vector3.zero
            return
        end

        dir = dir.Unit

        local look = hrp.CFrame.LookVector
        local cross = look:Cross(dir)
        local dot = math.clamp(look:Dot(dir), -1, 1)
        local angle = math.acos(dot)

        angVel.AngularVelocity = Vector3.new(
            0,
            cross.Y * angle * rotationSpeed,
            0
        )
    end)
end

local function stopMoving()
    moving = false
    currentTarget = nil
    stopFacing()
    if humanoid then
        humanoid:Move(Vector3.zero, false)
    end
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
end

local function onDeath()
    died = true
    needsFreshCharacter = true
    stopMoving()
end

local function getCharacter()
    if needsFreshCharacter then
        character = LocalPlayer.Character
        if character then
            local tempHumanoid = character:FindFirstChild("Humanoid")
            if tempHumanoid and tempHumanoid.Health > 0 then
                needsFreshCharacter = false
            else
                character = LocalPlayer.CharacterAdded:Wait()
                needsFreshCharacter = false
            end
        else
            character = LocalPlayer.CharacterAdded:Wait()
            needsFreshCharacter = false
        end
    else
        character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    end
    if not character then return false end

    local attempts = 0
    while attempts < 15 do
        hrp = character:FindFirstChild("HumanoidRootPart")
        humanoid = character:FindFirstChild("Humanoid")
        if hrp and humanoid and humanoid.Health > 0 then break end
        task.wait(0.2)
        attempts = attempts + 1
    end

    if humanoid and humanoid.Health > 0 then
        humanoid.Died:Connect(onDeath)
        return true
    end
    return false
end

local function moveToWaypoints(stageWaypoints)
    if not stageWaypoints then return end
    
    died = false
    
    for i, targetPos in ipairs(stageWaypoints) do
        if not features.autoFarm then
            stopMoving()
            return
        end
        
        if died then
            stopMoving()
            return
        end
        
        currentTarget = targetPos
        moving = true
        startFacing()
        
        while moving do
            if not features.autoFarm then
                stopMoving()
                return
            end
            
            if died or not hrp or not humanoid then
                stopMoving()
                return
            end
            
            local offset = targetPos - hrp.Position
            local distance = offset.Magnitude
            
            if distance < 4 then
                stopMoving()
                break
            end
            
            local direction = offset.Unit
            humanoid:Move(direction, false)
            hrp.AssemblyLinearVelocity = direction * currentSpeed
            task.wait()
        end
    end
end

local function startAutoFarm()
    while features.autoFarm do
        while not getCharacter() do
            task.wait(0.5)
        end
        
        task.wait(0.5)
        
        local stageWaypoints = waypoints[features.targetStage]
        if not stageWaypoints then return end
        
        moveToWaypoints(stageWaypoints)
        
        if died then
            died = false
            needsFreshCharacter = true
            task.wait(0.2)
        else
            task.wait(1)
        end
    end
end

local function stopAutoFarm()
    stopMoving()
    character = nil
    hrp = nil
    humanoid = nil
    died = false
    needsFreshCharacter = false
end

local section = shared.AddSection("World 3 Auto Farm")

section:AddParagraph("Additional Info", "Auto Farm For World 3 In +1 Speed Keyboard Escape | Candy & Chocolate\n\nCredits: @drowsynicolas")

section:AddToggle("Enable Auto Farm", function(bool)
    features.autoFarm = bool
    if bool then
        task.spawn(startAutoFarm)
    else
