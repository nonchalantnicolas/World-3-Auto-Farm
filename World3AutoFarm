local function getGameType()
    local placeId = game.PlaceId
    if placeId == PLACE_ID then
        return "world3"
    elseif placeId == WORLD_2_ID then
        return "world2"
    elseif placeId == WORLD_1_ID then
        return "world1"
    else
        return "other"
    end
end

local function checkWorld3()
    local gameType = getGameType()
    if gameType == "world3" then
        return true
    elseif gameType == "world1" or gameType == "world2" then
        shared.Notify("This feature was intended for World 3 ONLY", 3)
        return false
    else
        shared.Notify("This feature is not intended for this game", 3)
        return false
    end
end

local function shouldDisable(part)
    if part.Name == "LavaCollide" or part.Name == "LavaPart" then
        return true
    end

    local parent = part.Parent
    while parent do
        if parent.Name == "MovingWalls" then
            return true
        end
        parent = parent.Parent
    end

    return false
end

local function track(obj)
    if not obj:IsA("BasePart") then
        return
    end

    if shouldDisable(obj) then
        trackedParts[obj] = true
        obj.CanTouch = false
    end
end

local function enableSemiGodMode()
    if not checkWorld3() then
        features.semiGodMode = false
        return
    end
    
    if semiGodMaid then
        semiGodMaid:DoCleaning()
        semiGodMaid = nil
    end
    
    semiGodMaid = nicolas.new()
    trackedParts = {}
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        track(obj)
    end
    
    semiGodMaid:GiveTask(Workspace.DescendantAdded:Connect(track))
    
    semiGodMaid:GiveTask(RunService.Heartbeat:Connect(function()
        for part in pairs(trackedParts) do
            if part.Parent then
                if part.CanTouch then
                    part.CanTouch = false
                end
            else
                trackedParts[part] = nil
            end
        end
    end))
end

local function disableSemiGodMode()
    if semiGodMaid then
        semiGodMaid:DoCleaning()
        semiGodMaid = nil
    end
    
    for part in pairs(trackedParts) do
        if part.Parent then
            part.CanTouch = true
        end
        trackedParts[part] = nil
    end
    trackedParts = {}
end

local function enableNoclip()
    if not checkWorld3() then
        features.noclip = false
        return
    end
    
    if noclipMaid then
        noclipMaid:DoCleaning()
        noclipMaid = nil
    end
    
    noclipMaid = nicolas.new()
    noclipTracked = {}
    
    local function applyNoclip()
        local character = LocalPlayer.Character
        if not character then return end
        
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                noclipTracked[part] = part.CanCollide
                part.CanCollide = false
            end
        end
    end
    
    applyNoclip()
    
    noclipMaid:GiveTask(LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        applyNoclip()
    end))
    
    noclipMaid:GiveTask(RunService.Stepped:Connect(function()
        if not features.noclip then return end
        local character = LocalPlayer.Character
        if not character then return end
        
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end))
end

local function disableNoclip()
    if noclipMaid then
        noclipMaid:DoCleaning()
        noclipMaid = nil
    end
    
    local character = LocalPlayer.Character
    if character then
        for part, originalState in pairs(noclipTracked) do
            if part and part.Parent then
                part.CanCollide = originalState
            end
        end
    end
    noclipTracked = {}
end

local function Optimize(obj)
    if obj:IsA("MeshPart") then
        obj.Material = Enum.Material.Plastic
        obj.Reflectance = 0
        obj.CastShadow = false
        obj.TextureID = ""

        local sa = obj:FindFirstChildOfClass("SurfaceAppearance")
        if sa then
            sa:Destroy()
        end

    elseif obj:IsA("BasePart") then
        obj.Material = Enum.Material.Plastic
        obj.Reflectance = 0
        obj.CastShadow = false

    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        obj.Transparency = 1

    elseif obj:IsA("SurfaceAppearance") then
        obj:Destroy()

    elseif obj:IsA("ParticleEmitter") then
        obj.Enabled = false
        obj.Rate = 0
        obj.Lifetime = NumberRange.new(0)
        obj.Speed = NumberRange.new(0)

    elseif obj:IsA("Trail") then
        obj.Enabled = false
        obj.Lifetime = 0

    elseif obj:IsA("Beam") then
        obj.Enabled = false

    elseif obj:IsA("Explosion") then
        obj.BlastPressure = 1
        obj.BlastRadius = 1

    elseif obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Highlight") or obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
        obj.Enabled = false

    elseif obj:IsA("PostEffect") then
        obj.Enabled = false
    end
end

