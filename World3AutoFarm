local semiGodMaid = nil
local tracked = {}

local function shouldDisable(part)
    if part.Name == "LavaCollide" or part.Name == "LavaPart" then
        return true
    end

    local parent = part.Parent
    while parent do
        if parent.Name == "MovingWalls" then
            return true
        end
        parent = parent.Parent
    end

    return false
end

local function track(obj)
    if not obj:IsA("BasePart") then
        return
    end

    if shouldDisable(obj) then
        tracked[obj] = true
        obj.CanTouch = false
    end
end

local function enableSemiGodMode()
    if semiGodMaid then
        semiGodMaid:DoCleaning()
        semiGodMaid = nil
    end
    
    semiGodMaid = nicolas.new()
    tracked = {}
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        track(obj)
    end
    
    semiGodMaid:GiveTask(Workspace.DescendantAdded:Connect(track))
    
    semiGodMaid:GiveTask(RunService.Heartbeat:Connect(function()
        for part in pairs(tracked) do
            if part.Parent then
                if part.CanTouch then
                    part.CanTouch = false
                end
            else
                tracked[part] = nil
            end
        end
    end))
end

local function disableSemiGodMode()
    if semiGodMaid then
        semiGodMaid:DoCleaning()
        semiGodMaid = nil
    end
    
    for part in pairs(tracked) do
        if part.Parent then
            part.CanTouch = true
        end
        tracked[part] = nil
    end
    tracked = {}
end

local function stopFacing()
    if facingConn then
        facingConn:Disconnect()
        facingConn = nil
    end
    if att then
        att:Destroy()
        att = nil
    end
    if angVel then
        angVel:Destroy()
        angVel = nil
    end
    if autoRotateThread then
        autoRotateThread:Disconnect()
        autoRotateThread = nil
    end
    if humanoid then
        humanoid.AutoRotate = true
    end
end

local function startFacing()
    if not hrp then return end

    stopFacing()

    autoRotateThread = RunService.Heartbeat:Connect(function()
        if humanoid and humanoid.Parent then
            humanoid.AutoRotate = false
        end
    end)

    att = Instance.new("Attachment")
    att.Parent = hrp

    angVel = Instance.new("AngularVelocity")
    angVel.Attachment0 = att
    angVel.RelativeTo = Enum.ActuatorRelativeTo.World
    angVel.MaxTorque = math.huge
    angVel.AngularVelocity = Vector3.zero
    angVel.Parent = hrp

    facingConn = RunService.RenderStepped:Connect(function()
        if not hrp or not hrp.Parent then return end

        local _, y, _ = hrp.CFrame:ToOrientation()
        hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, y, 0)

        if not currentTarget then
            angVel.AngularVelocity = Vector3.zero
            return
        end

        local myPos = hrp.Position
        local targetPos = currentTarget

        local dir = Vector3.new(
            targetPos.X - myPos.X,
            0,
            targetPos.Z - myPos.Z
        )

        if dir.Magnitude < 0.001 then
            angVel.AngularVelocity = Vector3.zero
            return
        end

        dir = dir.Unit

        local look = hrp.CFrame.LookVector
        local cross = look:Cross(dir)
        local dot = math.clamp(look:Dot(dir), -1, 1)
        local angle = math.acos(dot)

        angVel.AngularVelocity = Vector3.new(
            0,
            cross.Y * angle * rotationSpeed,
            0
        )
    end)
end

local function stopMoving()
    moving = false
    currentTarget = nil
    stopFacing()
    if humanoid then
        humanoid:Move(Vector3.zero, false)
    end
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
end

local function onDeath()
    died = true
    needsFreshCharacter = true
    stopMoving()
end

local function getCharacter()
    if needsFreshCharacter then
        character = LocalPlayer.Character
        if character then
            local tempHumanoid = character:FindFirstChild("Humanoid")
            if tempHumanoid and tempHumanoid.Health > 0 then
                needsFreshCharacter = false
            else
                character = LocalPlayer.CharacterAdded:Wait()
                needsFreshCharacter = false
            end
        else
            character = LocalPlayer.CharacterAdded:Wait()
            needsFreshCharacter = false
        end
    else
        character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    end
    if not character then return false end

    local attempts = 0
    while attempts < 15 do
        hrp = character:FindFirstChild("HumanoidRootPart")
        humanoid = character:FindFirstChild("Humanoid")
        if hrp and humanoid and humanoid.Health > 0 then break end
        task.wait(0.2)
        attempts = attempts + 1
    end

    if humanoid and humanoid.Health > 0 then
        humanoid.Died:Connect(onDeath)
        return true
    end
    return false
end

local function moveToWaypoints(stageWaypoints)
    if not stageWaypoints then return end
    
    died = false
    
    for i, targetPos in ipairs(stageWaypoints) do
        if not features.autoFarm then
            stopMoving()
            return
        end
        
        if died then
            stopMoving()
            return
        end
        
        currentTarget = targetPos
        moving = true
        startFacing()
        
        while moving do
            if not features.autoFarm then
                stopMoving()
                return
            end
            
            if died or not hrp or not humanoid then
                stopMoving()
                return
            end
            
            local offset = targetPos - hrp.Position
            local distance = offset.Magnitude
            
            if distance < 4 then
                stopMoving()
                break
            end
            
            local direction = offset.Unit
            humanoid:Move(direction, false)
            hrp.AssemblyLinearVelocity = direction * currentSpeed
            task.wait()
        end
    end
end

local function startAutoFarm()
    local currentPlaceId = game.PlaceId
    
    if currentPlaceId == WORLD_1_ID then
        shared.Notify("Son this only works in world 3", 3)
        return
    elseif currentPlaceId == WORLD_2_ID then
        shared.Notify("Son this only works in world 3", 3)
        return
    elseif currentPlaceId ~= PLACE_ID then
        shared.Notify("Wrong game son", 3)
        return
    end
    
    while features.autoFarm do
        while not getCharacter() do
            task.wait(0.5)
        end
        
        task.wait(0.5)
        
        local stageWaypoints = waypoints[features.targetStage]
        if not stageWaypoints then return end
        
        moveToWaypoints(stageWaypoints)
        
        if died then
            died = false
            needsFreshCharacter = true
            task.wait(0.2)
        else
            task.wait(1)
        end
    end
end

local function stopAutoFarm()
    stopMoving()
    character = nil
    hrp = nil
    humanoid = nil
    died = false
    needsFreshCharacter = false
end

